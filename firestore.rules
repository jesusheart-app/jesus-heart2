rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isApprovedMember() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true;
    }

    function isApprovedAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.approved == true
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function hadPrayerReaction(prayerId, uid) {
      return exists(
          /databases/$(database)/documents/communityPrayers/$(prayerId)/privateReactions/$(uid)
        )
        && get(
          /databases/$(database)/documents/communityPrayers/$(prayerId)/privateReactions/$(uid)
        ).data.prayer == true;
    }

    function hadHeartReaction(prayerId, uid) {
      return exists(
          /databases/$(database)/documents/communityPrayers/$(prayerId)/privateReactions/$(uid)
        )
        && get(
          /databases/$(database)/documents/communityPrayers/$(prayerId)/privateReactions/$(uid)
        ).data.heart == true;
    }

    function hadAmenReaction(prayerId, uid) {
      return exists(
          /databases/$(database)/documents/communityPrayers/$(prayerId)/privateReactions/$(uid)
        )
        && get(
          /databases/$(database)/documents/communityPrayers/$(prayerId)/privateReactions/$(uid)
        ).data.amen == true;
    }

    function willHavePrayerReaction(prayerId, uid) {
      return getAfter(
        /databases/$(database)/documents/communityPrayers/$(prayerId)/privateReactions/$(uid)
      ).data.prayer == true;
    }

    function willHaveHeartReaction(prayerId, uid) {
      return getAfter(
        /databases/$(database)/documents/communityPrayers/$(prayerId)/privateReactions/$(uid)
      ).data.heart == true;
    }

    function willHaveAmenReaction(prayerId, uid) {
      return getAfter(
        /databases/$(database)/documents/communityPrayers/$(prayerId)/privateReactions/$(uid)
      ).data.amen == true;
    }

    function validReactionCounts(prayer) {
      return prayer.reactionPrayerCount is int
        && prayer.reactionPrayerCount >= 0
        && prayer.reactionHeartCount is int
        && prayer.reactionHeartCount >= 0
        && prayer.reactionAmenCount is int
        && prayer.reactionAmenCount >= 0;
    }

    function hasValidReactionCountChange(prayerId, uid) {
      return validReactionCounts(request.resource.data)
        && request.resource.data.reactionPrayerCount
          == resource.data.get('reactionPrayerCount', 0)
            + (willHavePrayerReaction(prayerId, uid) ? 1 : 0)
            - (hadPrayerReaction(prayerId, uid) ? 1 : 0)
        && request.resource.data.reactionHeartCount
          == resource.data.get('reactionHeartCount', 0)
            + (willHaveHeartReaction(prayerId, uid) ? 1 : 0)
            - (hadHeartReaction(prayerId, uid) ? 1 : 0)
        && request.resource.data.reactionAmenCount
          == resource.data.get('reactionAmenCount', 0)
            + (willHaveAmenReaction(prayerId, uid) ? 1 : 0)
            - (hadAmenReaction(prayerId, uid) ? 1 : 0);
    }

    function hadJoyReaction(gratitudeId, uid) {
      return exists(
          /databases/$(database)/documents/communityGratitudes/$(gratitudeId)/privateReactions/$(uid)
        )
        && get(
          /databases/$(database)/documents/communityGratitudes/$(gratitudeId)/privateReactions/$(uid)
        ).data.joy == true;
    }

    function hadThanksReaction(gratitudeId, uid) {
      return exists(
          /databases/$(database)/documents/communityGratitudes/$(gratitudeId)/privateReactions/$(uid)
        )
        && get(
          /databases/$(database)/documents/communityGratitudes/$(gratitudeId)/privateReactions/$(uid)
        ).data.thanks == true;
    }

    function hadGraceReaction(gratitudeId, uid) {
      return exists(
          /databases/$(database)/documents/communityGratitudes/$(gratitudeId)/privateReactions/$(uid)
        )
        && get(
          /databases/$(database)/documents/communityGratitudes/$(gratitudeId)/privateReactions/$(uid)
        ).data.grace == true;
    }

    function willHaveJoyReaction(gratitudeId, uid) {
      return getAfter(
        /databases/$(database)/documents/communityGratitudes/$(gratitudeId)/privateReactions/$(uid)
      ).data.joy == true;
    }

    function willHaveThanksReaction(gratitudeId, uid) {
      return getAfter(
        /databases/$(database)/documents/communityGratitudes/$(gratitudeId)/privateReactions/$(uid)
      ).data.thanks == true;
    }

    function willHaveGraceReaction(gratitudeId, uid) {
      return getAfter(
        /databases/$(database)/documents/communityGratitudes/$(gratitudeId)/privateReactions/$(uid)
      ).data.grace == true;
    }

    function validGratitudeReactionCounts(gratitude) {
      return gratitude.reactionJoyCount is int
        && gratitude.reactionJoyCount >= 0
        && gratitude.reactionThanksCount is int
        && gratitude.reactionThanksCount >= 0
        && gratitude.reactionGraceCount is int
        && gratitude.reactionGraceCount >= 0;
    }

    function hasValidGratitudeReactionCountChange(
      gratitudeId,
      uid
    ) {
      return validGratitudeReactionCounts(request.resource.data)
        && request.resource.data.reactionJoyCount
          == resource.data.get('reactionJoyCount', 0)
            + (willHaveJoyReaction(gratitudeId, uid) ? 1 : 0)
            - (hadJoyReaction(gratitudeId, uid) ? 1 : 0)
        && request.resource.data.reactionThanksCount
          == resource.data.get('reactionThanksCount', 0)
            + (willHaveThanksReaction(gratitudeId, uid) ? 1 : 0)
            - (hadThanksReaction(gratitudeId, uid) ? 1 : 0)
        && request.resource.data.reactionGraceCount
          == resource.data.get('reactionGraceCount', 0)
            + (willHaveGraceReaction(gratitudeId, uid) ? 1 : 0)
            - (hadGraceReaction(gratitudeId, uid) ? 1 : 0);
    }

    function hasValidSettings(settings) {
      return settings.keys().hasOnly(['fontSize', 'notifications'])
        && settings.fontSize in ['small', 'normal', 'large', 'extra-large']
        && settings.notifications is bool;
    }

    match /users/{uid} {
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'memberId',
          'name',
          'nameNormalized',
          'nameHash',
          'role',
          'approved',
          'createdAt',
          'settings'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.memberId is string
        && request.resource.data.memberId.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 40
        && request.resource.data.nameNormalized is string
        && request.resource.data.nameHash is string
        && request.resource.data.nameHash.size() == 64
        && request.resource.data.role == 'member'
        && request.resource.data.approved == false
        && request.resource.data.createdAt == request.time
        && request.resource.data.settings.fontSize == 'normal'
        && request.resource.data.settings.notifications == false
        && hasValidSettings(request.resource.data.settings);

      allow read: if isOwner(uid) || isApprovedAdmin();

      allow update: if (
          isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['settings'])
          && hasValidSettings(request.resource.data.settings)
        ) || (
          isApprovedAdmin()
          && request.resource.data.keys().hasOnly([
            'uid',
            'memberId',
            'name',
            'nameNormalized',
            'nameHash',
            'role',
            'approved',
            'createdAt',
            'settings'
          ])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.memberId == resource.data.memberId
          && request.resource.data.name == resource.data.name
          && request.resource.data.nameNormalized == resource.data.nameNormalized
          && request.resource.data.nameHash == resource.data.nameHash
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.role in ['member', 'admin']
          && request.resource.data.approved is bool
          && hasValidSettings(request.resource.data.settings)
        );

      allow delete: if isApprovedAdmin();
    }

    match /memberDirectory/{uid} {
      allow read: if isApprovedMember();
      allow create, update: if isOwner(uid)
        && isApprovedMember()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'updatedAt'])
        && request.resource.data.uid == uid
        && request.resource.data.name
          == get(/databases/$(database)/documents/users/$(uid)).data.name
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid) || isApprovedAdmin();
    }

    match /users/{uid}/bibleChecks/{dateKey} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly([
          'uid',
          'date',
          'checked',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.date == dateKey
        && request.resource.data.checked == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if false;
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/memoryChecks/{dateKey} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly([
          'uid',
          'date',
          'completed',
          'assessment',
          'verseId',
          'verseReference',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.date == dateKey
        && request.resource.data.completed
          == (request.resource.data.assessment == 'memorized')
        && request.resource.data.assessment in ['practicing', 'almost', 'memorized']
        && request.resource.data.verseId is string
        && request.resource.data.verseId.size() >= 1
        && request.resource.data.verseId.size() <= 80
        && request.resource.data.verseReference is string
        && request.resource.data.verseReference.size() >= 1
        && request.resource.data.verseReference.size() <= 100
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'date', 'completed', 'assessment', 'verseId',
          'verseReference', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.date == dateKey
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.assessment in ['practicing', 'almost', 'memorized']
        && request.resource.data.verseId is string
        && request.resource.data.verseId.size() >= 1
        && request.resource.data.verseId.size() <= 80
        && request.resource.data.verseReference is string
        && request.resource.data.verseReference.size() >= 1
        && request.resource.data.verseReference.size() <= 100
        && request.resource.data.completed
          == (request.resource.data.assessment == 'memorized')
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
    }

    match /memoryPassages/current {
      allow read: if isApprovedMember();
      allow create, update: if isApprovedAdmin()
        && request.resource.data.keys().hasOnly([
          'verses', 'currentVerseId', 'updatedBy', 'updatedAt'
        ])
        && request.resource.data.verses is list
        && request.resource.data.verses.size() <= 50
        && request.resource.data.currentVerseId is string
        && request.resource.data.currentVerseId.size() <= 80
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /communityBibleChecks/{dateKey}/participants/{uid} {
      allow read: if isApprovedMember();

      allow create: if isOwner(uid)
        && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly([
          'uid',
          'date',
          'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.date == dateKey
        && request.resource.data.createdAt == request.time
        && existsAfter(
          /databases/$(database)/documents/users/$(uid)/bibleChecks/$(dateKey)
        )
        && getAfter(
          /databases/$(database)/documents/users/$(uid)/bibleChecks/$(dateKey)
        ).data.checked == true;

      allow update: if false;
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/gratitudes/{gratitudeId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'date',
          'content',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.date is string
        && request.resource.data.date.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        )
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 2000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'date',
          'content',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.date is string
        && request.resource.data.date.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        )
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 2000
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(uid);
    }

    match /users/{uid}/wordNotes/{noteId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'date',
          'passage',
          'content',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.date is string
        && request.resource.data.date.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        )
        && request.resource.data.passage is string
        && request.resource.data.passage.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 5000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'date',
          'passage',
          'content',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.date is string
        && request.resource.data.date.matches(
          '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'
        )
        && request.resource.data.passage is string
        && request.resource.data.passage.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 5000
        && request.resource.data.updatedAt == request.time;

      allow delete: if isOwner(uid);
    }

    match /users/{uid}/prayers/{prayerId} {
      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'title',
          'content',
          'status',
          'createdAt',
          'updatedAt',
          'answeredAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 80
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 2000
        && request.resource.data.status == 'praying'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.answeredAt == null;

      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'title',
          'content',
          'status',
          'createdAt',
          'updatedAt',
          'answeredAt'
        ])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 80
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 2000
        && request.resource.data.status in ['praying', 'answered']
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.status == 'praying'
            && request.resource.data.answeredAt == null
          ) || (
            request.resource.data.status == 'answered'
            && request.resource.data.answeredAt is timestamp
          )
        );

      allow delete: if isOwner(uid);
    }

    match /communityGratitudes/{gratitudeId} {
      allow read: if isApprovedMember();

      allow create: if isApprovedMember()
        && request.resource.data.keys().hasOnly([
          'uid',
          'authorDisplay',
          'content',
          'reactionJoyCount',
          'reactionThanksCount',
          'reactionGraceCount',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorDisplay
          == get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.name
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 2000
        && request.resource.data.reactionJoyCount == 0
        && request.resource.data.reactionThanksCount == 0
        && request.resource.data.reactionGraceCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (
          isApprovedMember()
          && resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'uid',
            'authorDisplay',
            'content',
            'reactionJoyCount',
            'reactionThanksCount',
            'reactionGraceCount',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.authorDisplay
            == resource.data.authorDisplay
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('reactionJoyCount', 0)
            == resource.data.get('reactionJoyCount', 0)
          && request.resource.data.get('reactionThanksCount', 0)
            == resource.data.get('reactionThanksCount', 0)
          && request.resource.data.get('reactionGraceCount', 0)
            == resource.data.get('reactionGraceCount', 0)
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 1
          && request.resource.data.content.size() <= 2000
          && request.resource.data.updatedAt == request.time
        ) || (
          isApprovedMember()
          && resource.data.uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'reactionJoyCount',
              'reactionThanksCount',
              'reactionGraceCount'
            ])
          && hasValidGratitudeReactionCountChange(
            gratitudeId,
            request.auth.uid
          )
        );

      allow delete: if isApprovedMember()
        && resource.data.uid == request.auth.uid;
    }

    match /communityGratitudes/{gratitudeId}/privateReactions/{uid} {
      allow read: if isOwner(uid)
        && isApprovedMember()
        && exists(
          /databases/$(database)/documents/communityGratitudes/$(gratitudeId)
        );

      allow create, update: if isOwner(uid)
        && isApprovedMember()
        && exists(
          /databases/$(database)/documents/communityGratitudes/$(gratitudeId)
        )
        && get(
          /databases/$(database)/documents/communityGratitudes/$(gratitudeId)
        ).data.uid != request.auth.uid
        && request.resource.data.keys().hasOnly([
          'joy',
          'thanks',
          'grace',
          'updatedAt'
        ])
        && request.resource.data.joy is bool
        && request.resource.data.thanks is bool
        && request.resource.data.grace is bool
        && request.resource.data.updatedAt == request.time
        && getAfter(
          /databases/$(database)/documents/communityGratitudes/$(gratitudeId)
        ).data.reactionJoyCount
          == get(
            /databases/$(database)/documents/communityGratitudes/$(gratitudeId)
          ).data.get('reactionJoyCount', 0)
            + (request.resource.data.joy == true ? 1 : 0)
            - (hadJoyReaction(gratitudeId, uid) ? 1 : 0)
        && getAfter(
          /databases/$(database)/documents/communityGratitudes/$(gratitudeId)
        ).data.reactionThanksCount
          == get(
            /databases/$(database)/documents/communityGratitudes/$(gratitudeId)
          ).data.get('reactionThanksCount', 0)
            + (request.resource.data.thanks == true ? 1 : 0)
            - (hadThanksReaction(gratitudeId, uid) ? 1 : 0)
        && getAfter(
          /databases/$(database)/documents/communityGratitudes/$(gratitudeId)
        ).data.reactionGraceCount
          == get(
            /databases/$(database)/documents/communityGratitudes/$(gratitudeId)
          ).data.get('reactionGraceCount', 0)
            + (request.resource.data.grace == true ? 1 : 0)
            - (hadGraceReaction(gratitudeId, uid) ? 1 : 0);

      allow delete: if false;
    }

    match /communityGratitudes/{gratitudeId}/comments/{commentId} {
      allow read: if isApprovedMember()
        && exists(
          /databases/$(database)/documents/communityGratitudes/$(gratitudeId)
        );

      allow create: if isApprovedMember()
        && exists(
          /databases/$(database)/documents/communityGratitudes/$(gratitudeId)
        )
        && request.resource.data.keys().hasOnly([
          'uid',
          'authorDisplay',
          'content',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorDisplay
          == get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.name
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 500
        && request.resource.data.createdAt == request.time;

      allow update: if false;

      allow delete: if isApprovedMember()
        && (
          resource.data.uid == request.auth.uid
          || (
            get(
              /databases/$(database)/documents/communityGratitudes/$(gratitudeId)
            ).data.uid == request.auth.uid
            && !existsAfter(
              /databases/$(database)/documents/communityGratitudes/$(gratitudeId)
            )
          )
        );
    }

    match /communityPrayers/{prayerId} {
      allow read: if isApprovedMember();

      allow create: if isApprovedMember()
        && request.resource.data.keys().hasOnly([
          'uid',
          'title',
          'content',
          'isAnonymous',
          'authorDisplay',
          'reactionPrayerCount',
          'reactionHeartCount',
          'reactionAmenCount',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 80
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 2000
        && request.resource.data.isAnonymous is bool
        && (
          (
            request.resource.data.isAnonymous == true
            && request.resource.data.authorDisplay == '익명'
          ) || (
            request.resource.data.isAnonymous == false
            && request.resource.data.authorDisplay
              == get(
                /databases/$(database)/documents/users/$(request.auth.uid)
              ).data.name
          )
        )
        && request.resource.data.reactionPrayerCount == 0
        && request.resource.data.reactionHeartCount == 0
        && request.resource.data.reactionAmenCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if (
          isApprovedMember()
          && resource.data.uid == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'uid',
            'title',
            'content',
            'isAnonymous',
            'authorDisplay',
            'reactionPrayerCount',
            'reactionHeartCount',
            'reactionAmenCount',
            'createdAt',
            'updatedAt'
          ])
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.get('reactionPrayerCount', 0)
            == resource.data.get('reactionPrayerCount', 0)
          && request.resource.data.get('reactionHeartCount', 0)
            == resource.data.get('reactionHeartCount', 0)
          && request.resource.data.get('reactionAmenCount', 0)
            == resource.data.get('reactionAmenCount', 0)
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 80
          && request.resource.data.content is string
          && request.resource.data.content.size() >= 1
          && request.resource.data.content.size() <= 2000
          && request.resource.data.isAnonymous is bool
          && (
            (
              request.resource.data.isAnonymous == true
              && request.resource.data.authorDisplay == '익명'
            ) || (
              request.resource.data.isAnonymous == false
              && request.resource.data.authorDisplay
                == get(
                  /databases/$(database)/documents/users/$(request.auth.uid)
                ).data.name
            )
          )
          && request.resource.data.updatedAt == request.time
        ) || (
          isApprovedMember()
          && resource.data.uid != request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'reactionPrayerCount',
              'reactionHeartCount',
              'reactionAmenCount'
            ])
          && hasValidReactionCountChange(prayerId, request.auth.uid)
        );

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /communityPrayers/{prayerId}/comments/{commentId} {
      allow read: if isApprovedMember()
        && exists(
          /databases/$(database)/documents/communityPrayers/$(prayerId)
        );

      allow create: if isApprovedMember()
        && exists(
          /databases/$(database)/documents/communityPrayers/$(prayerId)
        )
        && request.resource.data.keys().hasOnly([
          'uid',
          'authorDisplay',
          'content',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorDisplay
          == get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.name
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 500
        && request.resource.data.createdAt == request.time;

      allow update: if false;

      allow delete: if isApprovedMember()
        && (
          resource.data.uid == request.auth.uid
          || (
            get(
              /databases/$(database)/documents/communityPrayers/$(prayerId)
            ).data.uid == request.auth.uid
            && !existsAfter(
              /databases/$(database)/documents/communityPrayers/$(prayerId)
            )
          )
        );
    }

    match /communityPrayers/{prayerId}/privateReactions/{uid} {
      allow read: if isOwner(uid)
        && isApprovedMember()
        && exists(
          /databases/$(database)/documents/communityPrayers/$(prayerId)
        );

      allow create, update: if isOwner(uid)
        && isApprovedMember()
        && exists(
          /databases/$(database)/documents/communityPrayers/$(prayerId)
        )
        && get(
          /databases/$(database)/documents/communityPrayers/$(prayerId)
        ).data.uid != request.auth.uid
        && request.resource.data.keys().hasOnly([
          'prayer',
          'heart',
          'amen',
          'updatedAt'
        ])
        && request.resource.data.prayer is bool
        && request.resource.data.heart is bool
        && request.resource.data.amen is bool
        && request.resource.data.updatedAt == request.time
        && getAfter(
          /databases/$(database)/documents/communityPrayers/$(prayerId)
        ).data.reactionPrayerCount
          == get(
            /databases/$(database)/documents/communityPrayers/$(prayerId)
          ).data.get('reactionPrayerCount', 0)
            + (request.resource.data.prayer == true ? 1 : 0)
            - (hadPrayerReaction(prayerId, uid) ? 1 : 0)
        && getAfter(
          /databases/$(database)/documents/communityPrayers/$(prayerId)
        ).data.reactionHeartCount
          == get(
            /databases/$(database)/documents/communityPrayers/$(prayerId)
          ).data.get('reactionHeartCount', 0)
            + (request.resource.data.heart == true ? 1 : 0)
            - (hadHeartReaction(prayerId, uid) ? 1 : 0)
        && getAfter(
          /databases/$(database)/documents/communityPrayers/$(prayerId)
        ).data.reactionAmenCount
          == get(
            /databases/$(database)/documents/communityPrayers/$(prayerId)
          ).data.get('reactionAmenCount', 0)
            + (request.resource.data.amen == true ? 1 : 0)
            - (hadAmenReaction(prayerId, uid) ? 1 : 0);

      allow delete: if false;
    }

    match /wordRooms/{roomId} {
      allow read: if isApprovedMember()
        && (
          request.auth.uid in resource.data.memberUids
          || isApprovedAdmin()
        );

      allow create: if isApprovedMember()
        && request.resource.data.keys().hasOnly([
          'type',
          'name',
          'description',
          'createdBy',
          'leaderUid',
          'leaderName',
          'memberUids',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.type in ['word', 'prayer']
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.leaderUid == request.auth.uid
        && request.resource.data.leaderName
          == get(
            /databases/$(database)/documents/users/$(request.auth.uid)
          ).data.name
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 1
        && request.resource.data.memberUids[0] == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isApprovedMember()
        && (
          resource.data.leaderUid == request.auth.uid
          || isApprovedAdmin()
          || (
            request.auth.uid in resource.data.memberUids
            && resource.data.leaderUid != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberUids', 'updatedAt'])
            && !(request.auth.uid in request.resource.data.memberUids)
            && request.resource.data.memberUids.size()
              == resource.data.memberUids.size() - 1
            && request.resource.data.memberUids.toSet()
              .difference(resource.data.memberUids.toSet()).size() == 0
          )
        )
        && request.resource.data.keys().hasOnly([
          'type',
          'name',
          'description',
          'createdBy',
          'leaderUid',
          'leaderName',
          'memberUids',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.get('type', 'word')
          == resource.data.get('type', 'word')
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 60
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() >= 1
        && request.resource.data.leaderUid in request.resource.data.memberUids
        && get(/databases/$(database)/documents/users/$(request.resource.data.leaderUid)).data.approved == true
        && request.resource.data.leaderName
          == get(/databases/$(database)/documents/users/$(request.resource.data.leaderUid)).data.name
        && request.resource.data.updatedAt == request.time;

      allow delete: if isApprovedMember()
        && (
          resource.data.leaderUid == request.auth.uid
          || isApprovedAdmin()
        );
    }

    match /wordRooms/{roomId}/members/{uid} {
      allow read: if isApprovedMember()
        && (
          exists(
            /databases/$(database)/documents/wordRooms/$(roomId)
          )
          && (
            request.auth.uid in get(
              /databases/$(database)/documents/wordRooms/$(roomId)
            ).data.memberUids
            || isApprovedAdmin()
          )
        );

      allow create: if isApprovedMember()
        && (
          getAfter(/databases/$(database)/documents/wordRooms/$(roomId)).data.leaderUid == request.auth.uid
          || isApprovedAdmin()
        )
        && getAfter(/databases/$(database)/documents/wordRooms/$(roomId)).data.memberUids.hasAny([uid])
        && get(/databases/$(database)/documents/users/$(uid)).data.approved == true
        && request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'role',
          'joinedAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.name
          == get(
            /databases/$(database)/documents/users/$(uid)
          ).data.name
        && request.resource.data.role
          == (getAfter(/databases/$(database)/documents/wordRooms/$(roomId)).data.leaderUid == uid ? 'leader' : 'member')
        && request.resource.data.joinedAt == request.time;

      allow update: if isApprovedMember()
        && (
          get(/databases/$(database)/documents/wordRooms/$(roomId)).data.leaderUid == request.auth.uid
          || isApprovedAdmin()
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role
          == (getAfter(/databases/$(database)/documents/wordRooms/$(roomId)).data.leaderUid == uid ? 'leader' : 'member');

      allow delete: if isApprovedMember()
        && (
          get(
            /databases/$(database)/documents/wordRooms/$(roomId)
          ).data.leaderUid == request.auth.uid
          || isApprovedAdmin()
          || (
            uid == request.auth.uid
            && get(
              /databases/$(database)/documents/wordRooms/$(roomId)
            ).data.leaderUid != uid
          )
        )
        && (
          !existsAfter(/databases/$(database)/documents/wordRooms/$(roomId))
          || (
            getAfter(/databases/$(database)/documents/wordRooms/$(roomId)).data.leaderUid != uid
            && !getAfter(/databases/$(database)/documents/wordRooms/$(roomId)).data.memberUids.hasAny([uid])
          )
        );
    }

    match /wordRooms/{roomId}/plans/{planId} {
      allow read: if isApprovedMember()
        && exists(/databases/$(database)/documents/wordRooms/$(roomId))
        && (
          request.auth.uid in get(
            /databases/$(database)/documents/wordRooms/$(roomId)
          ).data.memberUids
          || isApprovedAdmin()
        );

      allow create: if isApprovedMember()
        && get(/databases/$(database)/documents/wordRooms/$(roomId)).data.leaderUid
          == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'date', 'passage', 'note', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.passage is string
        && request.resource.data.passage.size() >= 1
        && request.resource.data.passage.size() <= 120
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isApprovedMember()
        && get(/databases/$(database)/documents/wordRooms/$(roomId)).data.leaderUid
          == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'date', 'passage', 'note', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.passage is string
        && request.resource.data.passage.size() >= 1
        && request.resource.data.passage.size() <= 120
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 500
        && request.resource.data.updatedAt == request.time;

      allow delete: if isApprovedMember()
        && (
          get(/databases/$(database)/documents/wordRooms/$(roomId)).data.leaderUid
            == request.auth.uid
          || isApprovedAdmin()
        );
    }

    match /wordRooms/{roomId}/plans/{planId}/comments/{commentId} {
      allow read: if isApprovedMember()
        && request.auth.uid in get(/databases/$(database)/documents/wordRooms/$(roomId)).data.memberUids;
      allow create: if isApprovedMember()
        && request.auth.uid in get(/databases/$(database)/documents/wordRooms/$(roomId)).data.memberUids
        && request.resource.data.keys().hasOnly(['uid', 'authorDisplay', 'content', 'reactionAmenCount', 'reactionGraceCount', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorDisplay == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 1000
        && request.resource.data.reactionAmenCount == 0
        && request.resource.data.reactionGraceCount == 0
        && request.resource.data.createdAt == request.time;
      allow update: if isApprovedMember()
        && resource.data.uid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionAmenCount', 'reactionGraceCount'])
        && request.resource.data.reactionAmenCount == resource.data.reactionAmenCount
          + (getAfter(/databases/$(database)/documents/wordRooms/$(roomId)/plans/$(planId)/comments/$(commentId)/privateReactions/$(request.auth.uid)).data.amen == true ? 1 : 0)
          - (exists(/databases/$(database)/documents/wordRooms/$(roomId)/plans/$(planId)/comments/$(commentId)/privateReactions/$(request.auth.uid))
            && get(/databases/$(database)/documents/wordRooms/$(roomId)/plans/$(planId)/comments/$(commentId)/privateReactions/$(request.auth.uid)).data.amen == true ? 1 : 0)
        && request.resource.data.reactionGraceCount == resource.data.reactionGraceCount
          + (getAfter(/databases/$(database)/documents/wordRooms/$(roomId)/plans/$(planId)/comments/$(commentId)/privateReactions/$(request.auth.uid)).data.grace == true ? 1 : 0)
          - (exists(/databases/$(database)/documents/wordRooms/$(roomId)/plans/$(planId)/comments/$(commentId)/privateReactions/$(request.auth.uid))
            && get(/databases/$(database)/documents/wordRooms/$(roomId)/plans/$(planId)/comments/$(commentId)/privateReactions/$(request.auth.uid)).data.grace == true ? 1 : 0);
      allow delete: if isApprovedMember()
        && (resource.data.uid == request.auth.uid
          || !existsAfter(/databases/$(database)/documents/wordRooms/$(roomId)/plans/$(planId)));
    }

    match /wordRooms/{roomId}/plans/{planId}/comments/{commentId}/privateReactions/{uid} {
      allow read: if isOwner(uid) && isApprovedMember();
      allow create, update: if isOwner(uid)
        && isApprovedMember()
        && request.resource.data.keys().hasOnly(['amen', 'grace', 'updatedAt'])
        && request.resource.data.amen is bool
        && request.resource.data.grace is bool
        && request.resource.data.updatedAt == request.time
        && get(/databases/$(database)/documents/wordRooms/$(roomId)/plans/$(planId)/comments/$(commentId)).data.uid != uid;
      allow delete: if isApprovedMember()
        && !existsAfter(/databases/$(database)/documents/wordRooms/$(roomId)/plans/$(planId)/comments/$(commentId));
    }

    match /wordRooms/{roomId}/prayerTopics/{topicId} {
      allow read: if isApprovedMember()
        && request.auth.uid in get(/databases/$(database)/documents/wordRooms/$(roomId)).data.memberUids;
      allow create: if isApprovedMember()
        && get(/databases/$(database)/documents/wordRooms/$(roomId)).data.get('type', 'word') == 'prayer'
        && request.auth.uid in get(/databases/$(database)/documents/wordRooms/$(roomId)).data.memberUids
        && request.resource.data.keys().hasOnly(['uid', 'authorDisplay', 'date', 'title', 'content', 'reactionAmenCount', 'reactionPrayerCount', 'createdAt', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorDisplay == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 1000
        && request.resource.data.reactionAmenCount == 0
        && request.resource.data.reactionPrayerCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if isApprovedMember() && (
        (
          resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['date', 'title', 'content', 'updatedAt'])
          && request.resource.data.date is string
          && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1
          && request.resource.data.title.size() <= 120
          && request.resource.data.content is string
          && request.resource.data.content.size() <= 1000
          && request.resource.data.updatedAt == request.time
        ) || (
          resource.data.uid != request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/wordRooms/$(roomId)).data.memberUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionAmenCount', 'reactionPrayerCount'])
          && request.resource.data.reactionAmenCount == resource.data.reactionAmenCount
            + (getAfter(/databases/$(database)/documents/wordRooms/$(roomId)/prayerTopics/$(topicId)/privateReactions/$(request.auth.uid)).data.amen == true ? 1 : 0)
            - (exists(/databases/$(database)/documents/wordRooms/$(roomId)/prayerTopics/$(topicId)/privateReactions/$(request.auth.uid))
              && get(/databases/$(database)/documents/wordRooms/$(roomId)/prayerTopics/$(topicId)/privateReactions/$(request.auth.uid)).data.amen == true ? 1 : 0)
          && request.resource.data.reactionPrayerCount == resource.data.reactionPrayerCount
            + (getAfter(/databases/$(database)/documents/wordRooms/$(roomId)/prayerTopics/$(topicId)/privateReactions/$(request.auth.uid)).data.prayer == true ? 1 : 0)
            - (exists(/databases/$(database)/documents/wordRooms/$(roomId)/prayerTopics/$(topicId)/privateReactions/$(request.auth.uid))
              && get(/databases/$(database)/documents/wordRooms/$(roomId)/prayerTopics/$(topicId)/privateReactions/$(request.auth.uid)).data.prayer == true ? 1 : 0)
        )
      );
      allow delete: if isApprovedMember() && (
        resource.data.uid == request.auth.uid
        || get(/databases/$(database)/documents/wordRooms/$(roomId)).data.leaderUid == request.auth.uid
        || isApprovedAdmin()
      );
    }

    match /wordRooms/{roomId}/prayerTopics/{topicId}/privateReactions/{uid} {
      allow read: if isOwner(uid) && isApprovedMember();
      allow create, update: if isOwner(uid) && isApprovedMember()
        && request.resource.data.keys().hasOnly(['amen', 'prayer', 'updatedAt'])
        && request.resource.data.amen is bool
        && request.resource.data.prayer is bool
        && request.resource.data.updatedAt == request.time
        && get(/databases/$(database)/documents/wordRooms/$(roomId)/prayerTopics/$(topicId)).data.uid != uid;
      allow delete: if isApprovedMember()
        && !existsAfter(/databases/$(database)/documents/wordRooms/$(roomId)/prayerTopics/$(topicId));
    }

    match /wordRooms/{roomId}/prayerTopics/{topicId}/comments/{commentId} {
      allow read: if isApprovedMember()
        && request.auth.uid in get(/databases/$(database)/documents/wordRooms/$(roomId)).data.memberUids;
      allow create: if isApprovedMember()
        && request.auth.uid in get(/databases/$(database)/documents/wordRooms/$(roomId)).data.memberUids
        && request.resource.data.keys().hasOnly(['uid', 'authorDisplay', 'content', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.authorDisplay == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isApprovedMember()
        && (resource.data.uid == request.auth.uid
          || !existsAfter(/databases/$(database)/documents/wordRooms/$(roomId)/prayerTopics/$(topicId)));
    }

    match /churchNews/{newsId} {
      allow read: if isApprovedMember();

      allow create: if isApprovedAdmin()
        && request.resource.data.keys().hasOnly([
          'title',
          'eventDate',
          'content',
          'pinned',
          'authorUid',
          'authorName',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 80
        && request.resource.data.eventDate is string
        && (
          request.resource.data.eventDate == ''
          || request.resource.data.eventDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        )
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 2000
        && request.resource.data.pinned is bool
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName
          == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isApprovedAdmin()
        && request.resource.data.keys().hasOnly([
          'title',
          'eventDate',
          'content',
          'pinned',
          'authorUid',
          'authorName',
          'createdAt',
          'updatedAt'
        ])
        && request.resource.data.authorUid == resource.data.authorUid
        && request.resource.data.authorName == resource.data.authorName
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 80
        && request.resource.data.eventDate is string
        && (
          request.resource.data.eventDate == ''
          || request.resource.data.eventDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        )
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 1
        && request.resource.data.content.size() <= 2000
        && request.resource.data.pinned is bool
        && request.resource.data.updatedAt == request.time;

      allow delete: if isApprovedAdmin();
    }

    match /loginNames/{nameHash}/members/{uid} {
      allow read: if true;

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid',
          'email',
          'memberId',
          'nameHash',
          'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.memberId.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.nameHash == nameHash
        && request.resource.data.nameHash.size() == 64
        && request.resource.data.createdAt == request.time;

      allow update: if false;
      allow delete: if isOwner(uid) || isApprovedAdmin();
    }

    match /memberIds/{memberId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && memberId.matches('^[A-HJ-NP-Z2-9]{6}$')
        && request.resource.data.createdAt == request.time;

      allow read, update: if isApprovedAdmin();
      allow delete: if isApprovedAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
